#!/usr/bin/env bash
# slopguard — anti-pattern detection and gate for agent-written code.
#
#   slopguard doctor [--install]   report tool status; install with --install
#   slopguard version              print version
#   slopguard help                 this message
#
# Requires: jq (or compatible). Other tool dependencies are installed by doctor.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

# Normalize plugin root and data across runtimes.
# Grok injects GROK_PLUGIN_ROOT/GROK_PLUGIN_DATA; Claude/Codex inject CLAUDE_* directly.
# Seeding CLAUDE_* from GROK_* here keeps all downstream scripts host-agnostic.
[ -n "${GROK_PLUGIN_ROOT:-}" ] && : "${CLAUDE_PLUGIN_ROOT:=$GROK_PLUGIN_ROOT}"
: "${CLAUDE_PLUGIN_ROOT:=$PLUGIN_ROOT}"
[ -n "${GROK_PLUGIN_DATA:-}" ] && : "${CLAUDE_PLUGIN_DATA:=$GROK_PLUGIN_DATA}"
: "${CLAUDE_PLUGIN_DATA:=${XDG_DATA_HOME:-$HOME/.local/share}/claude/plugins/slop-guard}"
export CLAUDE_PLUGIN_ROOT CLAUDE_PLUGIN_DATA

# Read identity from the manifest so nothing here hard-codes the plugin name.
manifest_field() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -1
}
VERSION="$(manifest_field version)"; [ -n "$VERSION" ] || VERSION="unknown"

# --------------------------------------------------------------------------- #
# plumbing
# --------------------------------------------------------------------------- #

die() { printf 'slopguard: %s\n' "$1" >&2; exit "${2:-1}"; }
say() { printf '%s\n' "$1"; }

ensure_jq() {
    command -v jq >/dev/null 2>&1 && return 0
    local managed_jq
    managed_jq="$(bootstrap_jq)" || die "jq is missing and the pinned bootstrap failed"
    PATH="$(dirname "$managed_jq"):${PATH}"
    export PATH
}

# shellcheck source=../lib/tools.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/tools.sh"
# shellcheck source=../lib/hook.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/hook.sh"
# shellcheck source=../lib/state.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/state.sh"
# shellcheck source=../lib/finding.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/finding.sh"

# --------------------------------------------------------------------------- #
# session-start
# --------------------------------------------------------------------------- #

cmd_session_start() {
    "${PLUGIN_ROOT}/hooks/session-start"
}

# --------------------------------------------------------------------------- #
# policy hooks
# --------------------------------------------------------------------------- #

cmd_pre_bash() {
    "${PLUGIN_ROOT}/hooks/pre-bash"
}

cmd_pre_write() {
    "${PLUGIN_ROOT}/hooks/pre-write"
}

cmd_pre_read() {
    "${PLUGIN_ROOT}/hooks/pre-read"
}

# --------------------------------------------------------------------------- #
# post-write
# --------------------------------------------------------------------------- #

cmd_post_write() {
    # Parse --tier=<value> flag; other args are silently ignored for
    # forward-compatibility with future tiers.
    local tier="fast"
    while [ $# -gt 0 ]; do
        case "$1" in
            --tier=*) tier="${1#--tier=}"; shift ;;
            --tier)   tier="${2:-fast}";   shift 2 ;;
            *)        shift ;;
        esac
    done
    case "$tier" in
        fast)
            # shellcheck source=../lib/diff.sh
            . "${CLAUDE_PLUGIN_ROOT}/lib/diff.sh"
            # shellcheck source=../lib/dispatch.sh
            . "${CLAUDE_PLUGIN_ROOT}/lib/dispatch.sh"
            # shellcheck source=../lib/ext.sh
            [ -f "${CLAUDE_PLUGIN_ROOT}/lib/ext.sh" ] \
                && . "${CLAUDE_PLUGIN_ROOT}/lib/ext.sh"
            "${PLUGIN_ROOT}/hooks/post-write"
            ;;
        *)
            # Unknown tier: exit 0 (fail-open — future tiers are not errors).
            exit 0
            ;;
    esac
}

# --------------------------------------------------------------------------- #
# note-docs
# --------------------------------------------------------------------------- #

cmd_note_docs() {
    # shellcheck source=../lib/docs.sh
    . "${CLAUDE_PLUGIN_ROOT}/lib/docs.sh"
    local raw; raw="$(cat)"
    local session_id agent_id library
    session_id="$(printf '%s' "$raw" | jq -r '.session_id // empty')"
    agent_id="$(printf '%s'  "$raw" | jq -r '.agent_id  // empty')"
    library="$(printf '%s'   "$raw" | jq -r \
        '.tool_input.libraryName // .tool_input.context7CompatibleLibraryID // .tool_input.query // empty')"
    # Missing session_id or library is a silent no-op — this hook must be invisible.
    if [ -z "$session_id" ] || [ -z "$library" ]; then
        exit 0
    fi
    docs_note "$session_id" "${agent_id:-}" "$library"
    # Record cross-session memory when the library matches a project framework version.
    # Silent no-op on any failure: missing profile, no framework match, jq error.
    local _ndd_profile; _ndd_profile="$(state_dir "$session_id" "${agent_id:-}")/profile.json"
    if [ -f "$_ndd_profile" ]; then
        local _ndd_fwv; _ndd_fwv="$(jq -r '.framework_versions // empty' \
            "$_ndd_profile" 2>/dev/null || true)"
        if [ -n "$_ndd_fwv" ]; then
            local _ndd_stacks; _ndd_stacks="${SLOPGUARD_STACKS_JSON:-${CLAUDE_PLUGIN_ROOT}/rules/stacks.json}"
            local _ndd_needle; _ndd_needle="$(printf '%s' "$library" | tr '[:upper:]' '[:lower:]')"
            local _ndd_pairs; _ndd_pairs="$(jq -r \
                --argjson fwv "$_ndd_fwv" \
                'to_entries
                 | map(select(.value.context7 != null and ($fwv[.key] != null)))
                 | map("\(.value.context7)|\($fwv[.key])")
                 | .[]' \
                "$_ndd_stacks" 2>/dev/null || true)"
            local _ndd_pair _ndd_query _ndd_ver _ndd_hay _ndd_hit
            while IFS= read -r _ndd_pair; do
                [ -n "$_ndd_pair" ] || continue
                _ndd_query="${_ndd_pair%%|*}"
                _ndd_ver="${_ndd_pair##*|}"
                _ndd_hay="$(printf '%s' "$_ndd_query" | tr '[:upper:]' '[:lower:]')"
                _ndd_hit=0
                case "$_ndd_hay" in *"$_ndd_needle"*) _ndd_hit=1 ;; esac
                [ "$_ndd_hit" -eq 0 ] && case "$_ndd_needle" in *"$_ndd_hay"*) _ndd_hit=1 ;; esac
                if [ "$_ndd_hit" -eq 1 ]; then
                    docs_remember "$_ndd_query" "$_ndd_ver" 2>/dev/null || true
                    break
                fi
            done <<< "$_ndd_pairs"
        fi
    fi
    exit 0
}

# --------------------------------------------------------------------------- #
# deps-check
# --------------------------------------------------------------------------- #

cmd_deps_check() {
    local deps_lib="${CLAUDE_PLUGIN_ROOT}/lib/deps.sh"
    [ -f "$deps_lib" ] || die "lib/deps.sh not found — run: slopguard doctor"
    # shellcheck source=../lib/deps.sh
    . "$deps_lib"
    deps_check_main "$@"
}

# --------------------------------------------------------------------------- #
# doctor
# --------------------------------------------------------------------------- #

cmd_doctor() {
    local do_install=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --install) do_install=1; shift ;;
            -*)        die "unknown flag for doctor: $1" ;;
            *)         die "unexpected argument: $1" ;;
        esac
    done

    detect_platform >/dev/null || die "unsupported platform"

    local lock_path; lock_path="$(_tools_lock)" || die "CLAUDE_PLUGIN_ROOT is not set"
    [ -f "$lock_path" ] || die "lockfile missing: $lock_path"

    local tools_list
    tools_list="$(lock_tools)" || die "lockfile unreadable or malformed: $lock_path"
    [ -n "$tools_list" ] || die "lockfile contains no tools: $lock_path"

    say "slopguard doctor — plugin: ${CLAUDE_PLUGIN_ROOT}  data: ${CLAUDE_PLUGIN_DATA}"
    say ""

    local fail_count=0

    while IFS= read -r tool; do
        local expected_version; expected_version="$(lock_version "$tool")"
        local refresh_attempted=0 refresh_failed=0
        if [ "$do_install" -eq 1 ] \
            && [ -n "$(lock_metadata "$tool" node_lock)" ] \
            && ! managed_metadata_matches "$tool"; then
            refresh_attempted=1
            say "  ${tool}  managed bundle metadata changed; reinstalling..."
            if install_tool "$tool"; then
                say "    → refreshed ${tool} ${expected_version}"
            else
                say "    → refresh FAILED"
                refresh_failed=1
            fi
        fi
        local resolved; resolved="$(resolve_tool "$tool")"
        local config_label; config_label="$(tool_config_path "$tool")"
        local fail_this="$refresh_failed"

        if [ -z "$resolved" ]; then
            fail_this=1
            say "  ${tool}  source: missing  lockfile: ${expected_version}  [NOT FOUND]  config: ${config_label}"
            local path_bin doctor_bin
            doctor_bin="$(lock_bin "$tool")"
            if path_bin="$(command -v "$doctor_bin" 2>/dev/null)"; then
                local path_ver; path_ver="$(tool_version_output "$tool" "$path_bin" | head -1 || true)"
                if tool_version_matches "$tool" "$path_bin"; then
                    say "    PATH: ${path_bin} (${path_ver}) — ignored by tool_source=${CLAUDE_PLUGIN_OPTION_TOOL_SOURCE:-project-first}"
                else
                    say "    PATH: ${path_bin} (${path_ver}) — rejected: version mismatch (want ${expected_version})"
                fi
            fi
        else
            local source_label version_label match_label
            local plugin_pfx="${CLAUDE_PLUGIN_DATA:-__NO_PLUGIN_DATA__}/tools/"
            case "$resolved" in
                "${plugin_pfx}"*)
                    source_label="plugin" ;;
                */vendor/bin/*|*/node_modules/.bin/*|*/.venv/bin/*)
                    source_label="project" ;;
                *)
                    if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && \
                       [ "${resolved#${CLAUDE_PROJECT_DIR}/}" != "$resolved" ]; then
                        source_label="project"
                    else
                        source_label="PATH"
                    fi
                    ;;
            esac

            version_label="$(tool_version_output "$tool" "$resolved" | head -1 || true)"

            if tool_version_matches "$tool" "$resolved"; then
                match_label="ok"
            else
                match_label="version mismatch (want ${expected_version})"
                fail_this=1
            fi

            say "  ${tool}  source: ${source_label}  version: ${version_label}  [${match_label}]  config: ${config_label}"
        fi

        if [ "$fail_this" -eq 1 ]; then
            fail_count=$((fail_count + 1))
            if [ "$do_install" -eq 1 ] && [ "$refresh_attempted" -eq 0 ]; then
                say "    → installing..."
                if install_tool "$tool"; then
                    local re_resolved; re_resolved="$(resolve_tool "$tool")"
                    if [ -n "$re_resolved" ] && tool_version_matches "$tool" "$re_resolved"; then
                        say "    → installed ${tool} ${expected_version}"
                        fail_count=$((fail_count - 1))
                    elif [ -n "$re_resolved" ]; then
                        say "    → installed ${tool} ${expected_version} but a higher-priority binary still wins — see above"
                    else
                        say "    → installed ${tool} ${expected_version} but the binary is not reachable in the current source mode"
                    fi
                else
                    say "    → install FAILED"
                fi
            elif [ -z "$resolved" ]; then
                say "    install:  slopguard doctor --install"
            fi
        fi
    done <<< "$tools_list"

    # Extensions section — always shown; informs the user about descriptor status.
    say ""
    local _ext_sh_doc; _ext_sh_doc="${SLOPGUARD_EXT_SH:-${CLAUDE_PLUGIN_ROOT}/lib/ext.sh}"
    if [ -f "$_ext_sh_doc" ]; then
        # shellcheck source=../lib/ext.sh
        . "$_ext_sh_doc"
        local _doc_proj; _doc_proj="${CLAUDE_PROJECT_DIR:-.}"
        local _doc_ext_dir; _doc_ext_dir="$(ext_dir "$_doc_proj")"
        say "Extensions (${_doc_ext_dir}):"
        if [ -d "$_doc_ext_dir" ]; then
            local _doc_ext_out; _doc_ext_out="$(ext_tools "$_doc_proj")"
            if [ -z "$_doc_ext_out" ]; then
                say "  (no tool descriptors)"
            else
                local _doc_obj _doc_name _doc_tier _doc_resolved _doc_status
                local _doc_label _doc_map_count _doc_map_file
                while IFS= read -r _doc_obj; do
                    [ -n "$_doc_obj" ] || continue
                    _doc_name="$(printf '%s' "$_doc_obj" | jq -r '.name // "?"')"
                    _doc_tier="$(printf '%s' "$_doc_obj" | jq -r '.tier // "?"')"
                    _doc_resolved="$(printf '%s' "$_doc_obj" | jq -r '.resolved // ""')"
                    _doc_status="$(printf '%s' "$_doc_obj" | jq -r '.status // "?"')"
                    case "$_doc_status" in
                        ok)
                            _doc_label="project: ${_doc_resolved#${_doc_proj}/}"
                            ;;
                        absent)
                            _doc_label="absent"
                            ;;
                        refused:*)
                            _doc_label="${_doc_status/refused:/refused: }"
                            ;;
                        *)
                            _doc_label="$_doc_status"
                            ;;
                    esac
                    _doc_map_count=0
                    _doc_map_file="${_doc_ext_dir}/mapping/${_doc_name}.yaml"
                    if [ -f "$_doc_map_file" ]; then
                        _doc_map_count="$(awk '
                            /^rules:/{in_rules=1;next}
                            in_rules && /^  [[:alnum:]]/{c++}
                            END{print c+0}
                        ' "$_doc_map_file")"
                    fi
                    say "  ${_doc_name}  tier: ${_doc_tier}  ${_doc_label}  overrides: ${_doc_map_count}"
                done <<< "$_doc_ext_out"
            fi
        else
            say "  (no .slopguard/ directory)"
        fi
    else
        say "Extensions:"
        say "  (lib/ext.sh not yet installed — extensions unavailable)"
    fi

    say ""
    if [ "$fail_count" -eq 0 ]; then
        say "All tools present and version-matched."
    else
        say "Some tools are missing or version-mismatched."
        if [ "$do_install" -eq 0 ]; then
            say "Run:  slopguard doctor --install"
        fi
        return 1
    fi
}

# --------------------------------------------------------------------------- #
# help
# --------------------------------------------------------------------------- #

cmd_help() {
    cat <<USAGE
slopguard ${VERSION} — anti-pattern detection and gate for agent-written code.

  slopguard doctor             report tool status (installs nothing)
  slopguard doctor --install   install or update pinned tools
  slopguard note-docs          record a Context7 lookup (reads hook JSON on stdin)
  slopguard deps-check         check dependency freshness against registries
  slopguard version            print version
  slopguard help               this message

Plugin root: ${CLAUDE_PLUGIN_ROOT}
Plugin data: ${CLAUDE_PLUGIN_DATA}

Tool resolution order (tool_source=project-first):
  1. Project binary  — vendor/bin, node_modules/.bin, .venv/bin, go tool -n
  2. Plugin binary   — \${CLAUDE_PLUGIN_DATA}/tools/<name>/current/<name>
                       accepted only when version equals the lockfile
  3. PATH binary     — only when version equals the lockfile

See tools/tools.lock.json for pinned versions and sha256 hashes.
USAGE
}

# --------------------------------------------------------------------------- #

case "${1:-help}" in
    session-start|pre-bash|pre-write|pre-read|post-write|doctor|note-docs|deps-check) ensure_jq ;;
esac

case "${1:-help}" in
    session-start)     shift; cmd_session_start "$@" ;;
    pre-bash)          shift; cmd_pre_bash "$@" ;;
    pre-write)         shift; cmd_pre_write "$@" ;;
    pre-read)          shift; cmd_pre_read "$@" ;;
    post-write)        shift; cmd_post_write "$@" ;;
    doctor)            shift; cmd_doctor "$@" ;;
    note-docs)         shift; cmd_note_docs "$@" ;;
    deps-check)        shift; cmd_deps_check "$@" ;;
    version|--version) say "slopguard ${VERSION}" ;;
    help|--help|-h)    cmd_help ;;
    *)                 die "unknown command '${1:-}' — try: slopguard help" ;;
esac
