# --------------------------------------------------------------------------- #
# doctor
# --------------------------------------------------------------------------- #

cmd_doctor() {
    local do_install=0 do_all=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --install) do_install=1; shift ;;
            --all)     do_all=1; shift ;;
            -*)        die "unknown flag for doctor: $1" ;;
            *)         die "unexpected argument: $1" ;;
        esac
    done

    detect_platform >/dev/null || die "unsupported platform"

    local lock_path; lock_path="$(_tools_lock)" || die "CLAUDE_PLUGIN_ROOT is not set"
    [ -f "$lock_path" ] || die "lockfile missing: $lock_path"

    local tools_list
    tools_list="$(lock_tools)" || die "lockfile unreadable or malformed: $lock_path"
    [ -n "$tools_list" ] || die "lockfile contains no tools: $lock_path"

    # Scope: only the tools the project's stacks can use, unless --all.  A repo
    # without Go has nothing to gain from a Go linter, so doctor neither reports
    # nor installs one.
    local scope_label="all pinned tools"
    if [ "$do_all" -eq 0 ]; then
        config_resolve_stacks "${CLAUDE_PROJECT_DIR:-.}"
        local relevant_tools; relevant_tools=" $(tools_for_stacks "${SG_STACKS:-}") "
        local scoped_list=""
        while IFS= read -r tool; do
            case "$relevant_tools" in
                *" ${tool} "*) scoped_list="${scoped_list}${tool}"$'\n' ;;
            esac
        done <<< "$tools_list"
        tools_list="${scoped_list%$'\n'}"
        scope_label="stacks: ${SG_STACKS:-none} (use --all for every pinned tool)"
        if [ -z "$tools_list" ]; then
            say "slopguard doctor — plugin: ${CLAUDE_PLUGIN_ROOT}  data: ${CLAUDE_PLUGIN_DATA}"
            say "scope: ${scope_label}"
            say ""
            say "No pinned tool applies to this project's stacks."
            return 0
        fi
    fi

    say "slopguard doctor — plugin: ${CLAUDE_PLUGIN_ROOT}  data: ${CLAUDE_PLUGIN_DATA}"
    say "scope: ${scope_label}"
    say ""

    local fail_count=0

    while IFS= read -r tool; do
        [ -n "$tool" ] || continue
        local expected_version; expected_version="$(lock_version "$tool")"
        local refresh_attempted=0 refresh_failed=0
        if [ "$do_install" -eq 1 ] \
            && [ -n "$(lock_metadata "$tool" node_lock)" ] \
            && ! managed_metadata_matches "$tool"; then
            refresh_attempted=1
            say "  ${tool}  managed bundle metadata changed; reinstalling..."
            if install_tool "$tool"; then
                say "    → refreshed ${tool} ${expected_version}"
            else
                say "    → refresh FAILED"
                refresh_failed=1
            fi
        fi
        local resolved; resolved="$(resolve_tool "$tool")"
        local config_label; config_label="$(tool_config_path "$tool")"
        local config_mode_label; config_mode_label="$(tool_config_mode "$tool")"
        local fail_this="$refresh_failed"

        if [ -z "$resolved" ]; then
            fail_this=1
            say "  ${tool}  source: missing  lockfile: ${expected_version}  [NOT FOUND]  config: ${config_label}  mode: ${config_mode_label}"
            local path_bin doctor_bin
            doctor_bin="$(lock_bin "$tool")"
            if path_bin="$(command -v "$doctor_bin" 2>/dev/null)"; then
                local path_ver; path_ver="$(tool_version_output "$tool" "$path_bin" | head -1 || true)"
                if tool_version_matches "$tool" "$path_bin"; then
                    say "    PATH: ${path_bin} (${path_ver}) — ignored by tool_source=${CLAUDE_PLUGIN_OPTION_TOOL_SOURCE:-project-first}"
                else
                    say "    PATH: ${path_bin} (${path_ver}) — rejected: version mismatch (want ${expected_version})"
                fi
            fi
        else
            local source_label version_label match_label
            local plugin_pfx="${CLAUDE_PLUGIN_DATA:-__NO_PLUGIN_DATA__}/tools/"
            case "$resolved" in
                "${plugin_pfx}"*)
                    source_label="plugin" ;;
                */vendor/bin/*|*/node_modules/.bin/*|*/.venv/bin/*)
                    source_label="project" ;;
                *)
                    if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && \
                       [ "${resolved#${CLAUDE_PROJECT_DIR}/}" != "$resolved" ]; then
                        source_label="project"
                    else
                        source_label="PATH"
                    fi
                    ;;
            esac

            version_label="$(tool_version_output "$tool" "$resolved" | head -1 || true)"

            if tool_version_matches "$tool" "$resolved"; then
                match_label="ok"
            else
                match_label="version mismatch (want ${expected_version})"
                fail_this=1
            fi

            say "  ${tool}  source: ${source_label}  version: ${version_label}  [${match_label}]  config: ${config_label}  mode: ${config_mode_label}"
        fi

        if [ "$fail_this" -eq 1 ]; then
            fail_count=$((fail_count + 1))
            if [ "$do_install" -eq 1 ] && [ "$refresh_attempted" -eq 0 ]; then
                say "    → installing..."
                if install_tool "$tool"; then
                    local re_resolved; re_resolved="$(resolve_tool "$tool")"
                    if [ -n "$re_resolved" ] && tool_version_matches "$tool" "$re_resolved"; then
                        say "    → installed ${tool} ${expected_version}"
                        fail_count=$((fail_count - 1))
                    elif [ -n "$re_resolved" ]; then
                        say "    → installed ${tool} ${expected_version} but a higher-priority binary still wins — see above"
                    else
                        say "    → installed ${tool} ${expected_version} but the binary is not reachable in the current source mode"
                    fi
                else
                    say "    → install FAILED"
                fi
            elif [ -z "$resolved" ]; then
                say "    install:  slopguard doctor --install"
            fi
        fi
    done <<< "$tools_list"

    # Extensions section — always shown; informs the user about descriptor status.
    say ""
    local _ext_sh_doc; _ext_sh_doc="${SLOPGUARD_EXT_SH:-${CLAUDE_PLUGIN_ROOT}/lib/ext.sh}"
    if [ -f "$_ext_sh_doc" ]; then
        # shellcheck source=../lib/ext.sh
        . "$_ext_sh_doc"
        local _doc_proj; _doc_proj="${CLAUDE_PROJECT_DIR:-.}"
        local _doc_ext_dir; _doc_ext_dir="$(ext_dir "$_doc_proj")"
        say "Extensions (${_doc_ext_dir}):"
        if [ -d "$_doc_ext_dir" ]; then
            local _doc_ext_out; _doc_ext_out="$(ext_tools "$_doc_proj")"
            if [ -z "$_doc_ext_out" ]; then
                say "  (no tool descriptors)"
            else
                local _doc_obj _doc_name _doc_tier _doc_resolved _doc_status
                local _doc_label _doc_map_count _doc_map_file
                while IFS= read -r _doc_obj; do
                    [ -n "$_doc_obj" ] || continue
                    _doc_name="$(printf '%s' "$_doc_obj" | jq -r '.name // "?"')"
                    _doc_tier="$(printf '%s' "$_doc_obj" | jq -r '.tier // "?"')"
                    _doc_resolved="$(printf '%s' "$_doc_obj" | jq -r '.resolved // ""')"
                    _doc_status="$(printf '%s' "$_doc_obj" | jq -r '.status // "?"')"
                    case "$_doc_status" in
                        ok)
                            _doc_label="project: ${_doc_resolved#${_doc_proj}/}"
                            ;;
                        absent)
                            _doc_label="absent"
                            ;;
                        refused:*)
                            _doc_label="${_doc_status/refused:/refused: }"
                            ;;
                        *)
                            _doc_label="$_doc_status"
                            ;;
                    esac
                    _doc_map_count=0
                    _doc_map_file="${_doc_ext_dir}/mapping/${_doc_name}.yaml"
                    if [ -f "$_doc_map_file" ]; then
                        _doc_map_count="$(awk '
                            /^rules:/{in_rules=1;next}
                            in_rules && /^  [[:alnum:]]/{c++}
                            END{print c+0}
                        ' "$_doc_map_file")"
                    fi
                    say "  ${_doc_name}  tier: ${_doc_tier}  ${_doc_label}  overrides: ${_doc_map_count}"
                done <<< "$_doc_ext_out"
            fi
        else
            say "  (no .slopguard/ directory)"
        fi
    else
        say "Extensions:"
        say "  (lib/ext.sh not yet installed — extensions unavailable)"
    fi

    say ""
    if [ "$fail_count" -eq 0 ]; then
        say "All tools present and version-matched."
    else
        say "Some tools are missing or version-mismatched."
        if [ "$do_install" -eq 0 ]; then
            say "Run:  slopguard doctor --install"
        fi
        return 1
    fi
}

# --------------------------------------------------------------------------- #
# adopt-config
# --------------------------------------------------------------------------- #

# _adopt_dest <tool> <project_dir>
# Prints the primary project config path for <tool> — where adopt-config writes.
# Mirrors the first candidate checked in tool_config_path for each tool.
# Returns empty string for tools that have no single-file config.
_adopt_dest() {
    local _ad_tool="$1" _ad_dir="$2"
    case "$_ad_tool" in
        betterleaks)   printf '%s/.gitleaks.toml'    "$_ad_dir" ;;
        checkov)       printf '%s/.checkov.yaml'      "$_ad_dir" ;;
        eslint-stack)  printf '%s/eslint.config.mjs'  "$_ad_dir" ;;
        golangci-lint) printf '%s/.golangci.yml'      "$_ad_dir" ;;
        hadolint)      printf '%s/.hadolint.yaml'     "$_ad_dir" ;;
        jscpd)         printf '%s/.jscpd.json'        "$_ad_dir" ;;
        kube-linter)   printf '%s/.kube-linter.yaml'  "$_ad_dir" ;;
        phpstan)       printf '%s/phpstan.neon'       "$_ad_dir" ;;
        psalm)         printf '%s/psalm.xml'          "$_ad_dir" ;;
        ruff)          printf '%s/ruff.toml'          "$_ad_dir" ;;
        tflint)        printf '%s/.tflint.hcl'        "$_ad_dir" ;;
        zizmor)        printf '%s/zizmor.yml'         "$_ad_dir" ;;
        *)             printf '' ;;
    esac
}

# _adopt_ext_dir <project_dir>
# Prints the directory that holds project tool descriptors.
_adopt_ext_dir() {
    local _ae_lib="${SLOPGUARD_EXT_SH:-${CLAUDE_PLUGIN_ROOT}/lib/ext.sh}"
    if ! declare -F ext_dir >/dev/null 2>&1 && [ -f "$_ae_lib" ]; then
        # shellcheck disable=SC1090  # path is resolved above, not a literal
        . "$_ae_lib"
    fi
    if declare -F ext_dir >/dev/null 2>&1; then
        printf '%s/tools' "$(ext_dir "$1")"
    else
        printf '%s/.slopguard/tools' "$1"
    fi
}

# _adopt_descriptor_template <name>
# Prints the shipped descriptor template for <name>, or nothing when the plugin
# ships none.  Descriptors cover analyzers the plugin deliberately does not pin
# because they only work from the project's own environment.
_adopt_descriptor_template() {
    local _at_path="${CLAUDE_PLUGIN_ROOT}/configs/baseline/descriptors/${1}.yaml"
    [ -f "$_at_path" ] && printf '%s' "$_at_path"
}

cmd_adopt_config() {
    local project_dir="${CLAUDE_PROJECT_DIR:-.}"
    local tool="${1:-}"

    if [ -z "$tool" ]; then
        # List tools without a project config, with the baseline each would copy.
        local _ac_found=0
        while IFS= read -r _ac_t; do
            local _ac_path; _ac_path="$(tool_config_path "$_ac_t" "$project_dir")"
            local _ac_src; _ac_src="$(tool_config_source "$_ac_path")"
            [ "$_ac_src" = "project" ] && continue   # already owned by project
            [ "$_ac_path" = "none" ] && continue     # jq, shellcheck — no config concept
            [ -d "$_ac_path" ] && continue            # opengrep uses a rule directory
            _ac_found=1
            printf '  %-20s  %s\n' "$_ac_t" "$_ac_path"
        done <<< "$(lock_tools)"
        local _ac_desc_dir; _ac_desc_dir="$(_adopt_ext_dir "$project_dir")"
        local _ac_tpl _ac_tpl_name
        for _ac_tpl in "${CLAUDE_PLUGIN_ROOT}"/configs/baseline/descriptors/*.yaml; do
            [ -f "$_ac_tpl" ] || continue
            _ac_tpl_name="${_ac_tpl##*/}"; _ac_tpl_name="${_ac_tpl_name%.yaml}"
            [ -f "${_ac_desc_dir}/${_ac_tpl_name}.yaml" ] && continue
            _ac_found=1
            printf '  %-20s  %s  (project-local descriptor)\n' "$_ac_tpl_name" "$_ac_tpl"
        done
        if [ "$_ac_found" -eq 0 ]; then
            say "All tools have project configs — nothing to adopt."
        else
            say ""
            say "Run: slopguard adopt-config <tool>  to copy a baseline into your project."
        fi
        return 0
    fi

    # Descriptor templates are adopted into .slopguard/tools/, not as a config.
    local _desc_tpl; _desc_tpl="$(_adopt_descriptor_template "$tool")"
    if [ -n "$_desc_tpl" ]; then
        local _desc_dir; _desc_dir="$(_adopt_ext_dir "$project_dir")"
        local _desc_dest="${_desc_dir}/${tool}.yaml"
        [ -f "$_desc_dest" ] && die "descriptor already exists: ${_desc_dest}"
        mkdir -p "$_desc_dir" || die "failed to create ${_desc_dir}"
        cp "$_desc_tpl" "$_desc_dest" || die "failed to copy ${_desc_tpl} → ${_desc_dest}"
        say "${_desc_dest}"
        say "${tool}: resolved from the project's own environment — slopguard installs nothing for it."
        say "Confirm it resolves:  slopguard doctor"
        return 0
    fi

    # Validate the tool name against the lockfile.
    local _ac_known=0
    while IFS= read -r _ac_t; do
        [ "$_ac_t" = "$tool" ] && { _ac_known=1; break; }
    done <<< "$(lock_tools)"
    [ "$_ac_known" -eq 0 ] && die "unknown tool '${tool}' — try: slopguard adopt-config"

    # Resolve existing config for this tool.
    local cfg_path; cfg_path="$(tool_config_path "$tool" "$project_dir")"
    local cfg_src; cfg_src="$(tool_config_source "$cfg_path")"

    # Already has a project config — refuse.
    if [ "$cfg_src" = "project" ]; then
        die "project config already exists: ${cfg_path}"
    fi

    [ "$cfg_path" = "none" ] \
        && die "tool '${tool}' has no config file (no-config tool — binary only)"

    # opengrep uses a rule directory; can't adopt as a single file.
    [ -d "$cfg_path" ] \
        && die "tool '${tool}' uses a rule directory — copy ${cfg_path} into your project manually"

    [ -f "$cfg_path" ] || die "baseline config not found: ${cfg_path}"

    # Determine the primary destination in the project.
    local dest; dest="$(_adopt_dest "$tool" "$project_dir")"
    [ -n "$dest" ] || die "tool '${tool}' does not support adopt-config"

    # Never overwrite — refuse with the filename so the user knows what to check.
    if [ -f "$dest" ]; then
        die "file already exists: ${dest}\n  Run: slopguard doctor  to confirm which config is active"
    fi

    cp "$cfg_path" "$dest" || die "failed to copy ${cfg_path} → ${dest}"

    say "${dest}"
    say "${tool}: this file is now the project's config and is write-protected from the agent (ask required to edit it)."
}


# --------------------------------------------------------------------------- #
# help
# --------------------------------------------------------------------------- #

cmd_help() {
    cat <<USAGE
slopguard ${VERSION} — anti-pattern detection and gate for agent-written code.

  slopguard doctor             report tool status for the project's stacks
  slopguard doctor --install   install or update the tools those stacks need
  slopguard doctor --all       widen either command to every pinned tool
  slopguard adopt-config       list tools without a project config
  slopguard adopt-config <t>   copy the baseline config for <t> into the project
  slopguard note-docs          record a Context7 lookup (reads hook JSON on stdin)
  slopguard deps-check         check dependency freshness against registries
  slopguard version            print version
  slopguard help               this message

Plugin root: ${CLAUDE_PLUGIN_ROOT}
Plugin data: ${CLAUDE_PLUGIN_DATA}

Tool resolution order (tool_source=project-first):
  1. Project binary  — vendor/bin, node_modules/.bin, .venv/bin, go tool -n
  2. Plugin binary   — \${CLAUDE_PLUGIN_DATA}/tools/<name>/current/<name>
                       accepted only when version equals the lockfile
  3. PATH binary     — only when version equals the lockfile

See tools/tools.lock.json for pinned versions and sha256 hashes.
USAGE
}
# --------------------------------------------------------------------------- #
# stop-gate
# --------------------------------------------------------------------------- #

cmd_stop_gate() {
    # Source lib/stop.sh when present (Etap 4 — fail-open before it ships).
    [ -f "${CLAUDE_PLUGIN_ROOT}/lib/stop.sh" ] && . "${CLAUDE_PLUGIN_ROOT}/lib/stop.sh"
    # Delegate to hooks/stop; exit 0 if not yet deployed.
    if [ -f "${PLUGIN_ROOT}/hooks/stop" ]; then
        exec "${PLUGIN_ROOT}/hooks/stop" "$@"
    fi
    # hooks/stop not yet deployed: fail-open.
    exit 0
}

# --------------------------------------------------------------------------- #

case "${1:-help}" in
    session-start|pre-bash|pre-write|pre-read|post-write|doctor|note-docs|deps-check|stop-gate|adopt-config) ensure_jq ;;
esac

case "${1:-help}" in
    session-start)     shift; cmd_session_start "$@" ;;
    pre-bash)          shift; cmd_pre_bash "$@" ;;
    pre-write)         shift; cmd_pre_write "$@" ;;
    pre-read)          shift; cmd_pre_read "$@" ;;
    post-write)        shift; cmd_post_write "$@" ;;
    stop-gate)         shift; cmd_stop_gate "$@" ;;
    doctor)            shift; cmd_doctor "$@" ;;
    adopt-config)      shift; cmd_adopt_config "$@" ;;
    note-docs)         shift; cmd_note_docs "$@" ;;
    deps-check)        shift; cmd_deps_check "$@" ;;
    version|--version) say "slopguard ${VERSION}" ;;
    help|--help|-h)    cmd_help ;;
    *)                 die "unknown command '${1:-}' — try: slopguard help" ;;
esac
