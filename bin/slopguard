#!/usr/bin/env bash
# slopguard — anti-pattern detection and gate for agent-written code.
#
#   slopguard doctor [--install]   report tool status; install with --install
#   slopguard version              print version
#   slopguard help                 this message
#
# Requires: jq (or compatible). Other tool dependencies are installed by doctor.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

# Normalize plugin root and data across runtimes.
# Grok injects GROK_PLUGIN_ROOT/GROK_PLUGIN_DATA; Claude/Codex inject CLAUDE_* directly.
# Seeding CLAUDE_* from GROK_* here keeps all downstream scripts host-agnostic.
[ -n "${GROK_PLUGIN_ROOT:-}" ] && : "${CLAUDE_PLUGIN_ROOT:=$GROK_PLUGIN_ROOT}"
: "${CLAUDE_PLUGIN_ROOT:=$PLUGIN_ROOT}"
[ -n "${GROK_PLUGIN_DATA:-}" ] && : "${CLAUDE_PLUGIN_DATA:=$GROK_PLUGIN_DATA}"
: "${CLAUDE_PLUGIN_DATA:=${XDG_DATA_HOME:-$HOME/.local/share}/claude/plugins/slop-guard}"
export CLAUDE_PLUGIN_ROOT CLAUDE_PLUGIN_DATA

# Read identity from the manifest so nothing here hard-codes the plugin name.
manifest_field() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -1
}
VERSION="$(manifest_field version)"; [ -n "$VERSION" ] || VERSION="unknown"

# --------------------------------------------------------------------------- #
# plumbing
# --------------------------------------------------------------------------- #

die() { printf 'slopguard: %s\n' "$1" >&2; exit "${2:-1}"; }
say() { printf '%s\n' "$1"; }

ensure_jq() {
    command -v jq >/dev/null 2>&1 && return 0
    local managed_jq
    managed_jq="$(bootstrap_jq)" || die "jq is missing and the pinned bootstrap failed"
    PATH="$(dirname "$managed_jq"):${PATH}"
    export PATH
}

# shellcheck source=../lib/tools.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/tools.sh"
# shellcheck source=../lib/hook.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/hook.sh"
# shellcheck source=../lib/state.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/state.sh"
# shellcheck source=../lib/finding.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/finding.sh"
# shellcheck source=../lib/detect.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/detect.sh"
# shellcheck source=../lib/config.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/config.sh"

# Fallback: tool_config_mode is defined in lib/tools.sh (ConfigMode slice).
# This stub fires only when that slice hasn't landed yet; the contract is identical.
# Unknown CONFIG_SOURCE values → overlay (safe: a typo must not disable the guard).
if ! declare -F tool_config_mode >/dev/null 2>&1; then
    tool_config_mode() {
        local _tcm_t="$1" _tcm_pd="${2:-${CLAUDE_PROJECT_DIR:-}}"
        local _tcm_cp; _tcm_cp="$(tool_config_path "$_tcm_t" "$_tcm_pd")"
        case "$(tool_config_source "$_tcm_cp")" in
            project) printf 'project' ;;
            *)
                case "${CLAUDE_PLUGIN_OPTION_CONFIG_SOURCE:-overlay}" in
                    full)         printf 'full' ;;
                    project-only) printf 'skip' ;;
                    *)            printf 'overlay' ;;
                esac
                ;;
        esac
    }
fi

