# --------------------------------------------------------------------------- #
# post-write (fast and medium tiers)
# --------------------------------------------------------------------------- #

# _cmd_post_write_medium — reads hook JSON from stdin (already consumed by
# hook_input), runs dispatch_medium, and exits 2 when new error/blocker
# findings are present (asyncRewake).  Advisory mode uses additionalContext.
# Warn-only findings use additionalContext without exit 2.
_cmd_post_write_medium() {
    hook_input

    local tool_name; tool_name="$(hook_field .tool_name)"
    local file_path=""
    case "$tool_name" in
        Write|Edit|MultiEdit)  file_path="$(hook_field .tool_input.file_path)" ;;
        NotebookEdit)          file_path="$(hook_field .tool_input.notebook_path)" ;;
        *) exit 0 ;;
    esac

    [ -n "$file_path" ] || exit 0
    [ -f "$file_path" ] || exit 0

    local session_id; session_id="$(hook_field .session_id)"
    local agent_id;   agent_id="$(hook_field .agent_id)"
    [ -n "$session_id" ] || exit 0

    local enforcement="${CLAUDE_PLUGIN_OPTION_ENFORCEMENT_MODE:-balanced}"
    local project_dir="${CLAUDE_PROJECT_DIR:-.}"

    local findings_tmp; findings_tmp="$(mktemp "${TMPDIR:-/tmp}/.sg-med-findings.XXXXXX")"
    trap 'rm -f "${findings_tmp}"' EXIT INT TERM

    dispatch_medium "$file_path" "$session_id" "${agent_id:-}" "$project_dir" "$findings_tmp"

    # Debounced away, no tools apply, or all findings already fingerprinted.
    [ -s "$findings_tmp" ] || exit 0

    local findings_json total
    findings_json="$(jq -s '.' "$findings_tmp" 2>/dev/null || printf '[]')"
    total="$(printf '%s\n' "$findings_json" | jq 'length' 2>/dev/null || printf '0')"
    [ "$total" -gt 0 ] || exit 0

    # Apply 20-finding cap (Z4).
    local MAX_FINDINGS=20
    local capped; capped="$(printf '%s\n' "$findings_json" \
        | jq --argjson max "$MAX_FINDINGS" '.[0:$max]')"
    local overflow; overflow=$(( total > MAX_FINDINGS ? total - MAX_FINDINGS : 0 ))

    local n_blocker n_error n_warn n_info
    n_blocker="$(printf '%s\n' "$capped" | jq '[.[] | select(.severity=="blocker")] | length')"
    n_error="$(printf '%s\n' "$capped"   | jq '[.[] | select(.severity=="error")]   | length')"
    n_warn="$(printf '%s\n' "$capped"    | jq '[.[] | select(.severity=="warn")]    | length')"
    n_info="$(printf '%s\n' "$capped"    | jq '[.[] | select(.severity=="info")]    | length')"

    # Medium tier: only new findings ≥ error wake the agent (§11.3 criterion).
    local n_actionable; n_actionable=$(( n_blocker + n_error ))

    # Build §4.7 header.
    local header_parts=""
    [ "$n_blocker" -gt 0 ] && header_parts="${header_parts}${n_blocker} blocker$([ "$n_blocker" -ne 1 ] && printf 's'), "
    [ "$n_error"   -gt 0 ] && header_parts="${header_parts}${n_error} error$([ "$n_error" -ne 1 ] && printf 's'), "
    [ "$n_warn"    -gt 0 ] && header_parts="${header_parts}${n_warn} warning$([ "$n_warn" -ne 1 ] && printf 's'), "
    [ "$n_info"    -gt 0 ] && header_parts="${header_parts}${n_info} info, "
    header_parts="${header_parts%, }"
    local header="slopguard: ${header_parts} in changed code (medium tier)"

    # Build §4.7 body.
    local body_lines
    body_lines="$(printf '%s\n' "$capped" | jq -r '
        group_by(.file)[] |
        (.[0].file) as $f |
        ($f + "\n") +
        (map(
            "  " +
            (if .severity == "blocker" then "BLOCKER"
             elif .severity == "error" then "ERROR  "
             elif .severity == "warn"  then "WARN   "
             else "INFO   " end) + " " +
            (if .line > 0 then "L\(.line) " else "" end) +
            .ap_id + " " +
            (if (.cwe | length) > 0 then .cwe[0] + " " else "" end) +
            "[\(.tool):\(.tool_rule)] " +
            .message +
            (if .fix != "" then ". Fix: " + .fix else "" end)
        ) | join("\n"))
    ' 2>/dev/null || true)"

    # Details lines for error/blocker AP-ids.
    local unique_ap_ids details_lines=""
    unique_ap_ids="$(printf '%s\n' "$capped" | jq -r \
        '[.[] | select(.severity == "blocker" or .severity == "error") | .ap_id] | unique | .[]' \
        2>/dev/null | head -5 || true)"
    while IFS= read -r _ap; do
        [ -n "$_ap" ] || continue
        local _skill=""
        case "$_ap" in
            AP-PHP-*)              _skill="php-antipatterns" ;;
            AP-GO-*)               _skill="go-antipatterns" ;;
            AP-PY-*)               _skill="python-antipatterns" ;;
            AP-TS-*|AP-NODE-*)     _skill="ts-react-antipatterns" ;;
            AP-K8S-*|AP-TF-*|AP-DOCKER-*|AP-CI-*) _skill="iac-antipatterns" ;;
            AP-SQL-*)              _skill="sql-antipatterns" ;;
            *)                     _skill="${_ap%%-*}-antipatterns" ;;
        esac
        details_lines="${details_lines}Details: skills ${_skill}/reference/${_ap}.md\n"
    done <<< "$unique_ap_ids"

    local msg="${header}"$'\n'"${body_lines}"
    [ -n "$details_lines" ] && msg="${msg}"$'\n'"$(printf '%b' "${details_lines}")"
    [ "$overflow" -gt 0 ] \
        && msg="${msg}"$'\n'"+${overflow} more findings (run: slopguard scan ${file_path})"

    # Trim to 4000 chars (Z4).
    [ "${#msg}" -gt 4000 ] && msg="${msg:0:3990}..."

    # Enforce modes §4.6.
    case "$enforcement" in
        advisory)
            hook_context "$msg"
            ;;
        balanced|strict)
            if [ "$n_actionable" -gt 0 ]; then
                printf '%s\n' "$msg" >&2
                exit 2
            elif [ "$n_warn" -gt 0 ]; then
                hook_context "$msg"
            fi
            ;;
    esac

    exit 0
}

cmd_post_write() {
    # Parse --tier=<value> flag; other args are silently ignored for
    # forward-compatibility with future tiers.
    local tier="fast"
    while [ $# -gt 0 ]; do
        case "$1" in
            --tier=*) tier="${1#--tier=}"; shift ;;
            --tier)   tier="${2:-fast}";   shift 2 ;;
            *)        shift ;;
        esac
    done
    case "$tier" in
        fast)
            # shellcheck source=../lib/diff.sh
            . "${CLAUDE_PLUGIN_ROOT}/lib/diff.sh"
            # shellcheck source=../lib/dispatch.sh
            . "${CLAUDE_PLUGIN_ROOT}/lib/dispatch.sh"
            # shellcheck source=../lib/ext.sh
            [ -f "${CLAUDE_PLUGIN_ROOT}/lib/ext.sh" ] \
                && . "${CLAUDE_PLUGIN_ROOT}/lib/ext.sh"
            "${PLUGIN_ROOT}/hooks/post-write"
            ;;
        medium)
            # shellcheck source=../lib/diff.sh
            . "${CLAUDE_PLUGIN_ROOT}/lib/diff.sh"
            # shellcheck source=../lib/dispatch.sh
            . "${CLAUDE_PLUGIN_ROOT}/lib/dispatch.sh"
            # shellcheck source=../lib/ext.sh
            [ -f "${CLAUDE_PLUGIN_ROOT}/lib/ext.sh" ] \
                && . "${CLAUDE_PLUGIN_ROOT}/lib/ext.sh"
            _cmd_post_write_medium
            ;;
        *)
            # Unknown tier: exit 0 (fail-open — future tiers are not errors).
            exit 0
            ;;
    esac
}

# --------------------------------------------------------------------------- #
# note-docs
# --------------------------------------------------------------------------- #

cmd_note_docs() {
    # shellcheck source=../lib/docs.sh
    . "${CLAUDE_PLUGIN_ROOT}/lib/docs.sh"
    local raw; raw="$(cat)"
    local session_id agent_id library
    session_id="$(printf '%s' "$raw" | jq -r '.session_id // empty')"
    agent_id="$(printf '%s'  "$raw" | jq -r '.agent_id  // empty')"
    library="$(printf '%s'   "$raw" | jq -r \
        '.tool_input.libraryName // .tool_input.context7CompatibleLibraryID // .tool_input.query // empty')"
    # Missing session_id or library is a silent no-op — this hook must be invisible.
    if [ -z "$session_id" ] || [ -z "$library" ]; then
        exit 0
    fi
    docs_note "$session_id" "${agent_id:-}" "$library"
    # Record cross-session memory when the library matches a project framework version.
    # Silent no-op on any failure: missing profile, no framework match, jq error.
    local _ndd_profile; _ndd_profile="$(state_dir "$session_id" "${agent_id:-}")/profile.json"
    if [ -f "$_ndd_profile" ]; then
        local _ndd_fwv; _ndd_fwv="$(jq -r '.framework_versions // empty' \
            "$_ndd_profile" 2>/dev/null || true)"
        if [ -n "$_ndd_fwv" ]; then
            local _ndd_stacks; _ndd_stacks="${SLOPGUARD_STACKS_JSON:-${CLAUDE_PLUGIN_ROOT}/rules/stacks.json}"
            local _ndd_needle; _ndd_needle="$(printf '%s' "$library" | tr '[:upper:]' '[:lower:]')"
            local _ndd_pairs; _ndd_pairs="$(jq -r \
                --argjson fwv "$_ndd_fwv" \
                'to_entries
                 | map(select(.value.context7 != null and ($fwv[.key] != null)))
                 | map("\(.value.context7)|\($fwv[.key])")
                 | .[]' \
                "$_ndd_stacks" 2>/dev/null || true)"
            local _ndd_pair _ndd_query _ndd_ver _ndd_hay _ndd_hit
            while IFS= read -r _ndd_pair; do
                [ -n "$_ndd_pair" ] || continue
                _ndd_query="${_ndd_pair%%|*}"
                _ndd_ver="${_ndd_pair##*|}"
                _ndd_hay="$(printf '%s' "$_ndd_query" | tr '[:upper:]' '[:lower:]')"
                _ndd_hit=0
                case "$_ndd_hay" in *"$_ndd_needle"*) _ndd_hit=1 ;; esac
                [ "$_ndd_hit" -eq 0 ] && case "$_ndd_needle" in *"$_ndd_hay"*) _ndd_hit=1 ;; esac
                if [ "$_ndd_hit" -eq 1 ]; then
                    docs_remember "$_ndd_query" "$_ndd_ver" 2>/dev/null || true
                    break
                fi
            done <<< "$_ndd_pairs"
        fi
    fi
    exit 0
}

